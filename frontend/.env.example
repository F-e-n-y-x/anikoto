# Both are optional — sensible defaults are baked in for the combined
# single-port setup (server.js spawns this frontend and proxies to it).
#
# API_INTERNAL_BASE — used by server components (Node, running on the
# same machine as the API) — defaults to http://localhost:4444/api
#
# NEXT_PUBLIC_API_BASE — used by the browser — defaults to the relative
# path "/api", which resolves correctly regardless of how the page was
# reached (localhost, a LAN IP from a phone, a real domain in prod).
# Only set this if the frontend is ever served from a different origin
# than the API.
# API_INTERNAL_BASE=http://localhost:4444/api
# NEXT_PUBLIC_API_BASE=/api
